{
  "name": "movie-tvshow-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node --loader ts-node/esm ./server/main.ts",
    "dev": "cross-env NODE_NO_WARNINGS=1 nodemon --exec 'node --loader ts-node/esm' ./server/main.ts",
    "start:debug:ts": "node --inspect --loader ts-node/esm ./server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/auth": "^4.6.1",
    "@fastify/cors": "9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "aws-sdk": "^2.1658.0",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "mongoose": "^8.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/bcrypt": "^5.0.2",
    "@types/fastify-jwt": "^0.8.1",
    "@types/node": "^20.13.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nodemon": "^3.1.2",
    "prettier": "3.3.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  },
  "private": true,
  "description": "HTTP REST API for movies and TV shows (Fastify, TypeScript, Zod, JWT, MongoDB, AWS), built with Clean Architecture.",
  "keywords": [
    "fastify",
    "typescript",
    "clean-architecture",
    "rest-api"
  ],
  "author": "Federico Irarrazaval",
  "license": "MIT"
}
