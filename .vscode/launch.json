{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "npm run dev",
      "name": "Run npm dev",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Launch via nodemon",
      "type": "node",
      "request": "launch",
      "protocol": "inspector",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "${workspaceFolder}/backend/node_modules/.bin/ts-node-dev",
      "args": ["server/main.ts"],
      "restart": true
    }
  ]
}
